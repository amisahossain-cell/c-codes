include <stdio.h>

int main() {
    int a[5] = {10, 20, 30, 40, 50};
    int b[2][3] = {{1, 2, 3}, {4, 5, 6}};
    int i, j;

    printf("1D array:\n");

    for(i = 0; i < 5; i++) {
        printf("%d ", a[i]);
    }

    printf("\n2D array:\n");

    for(i = 0; i < 2; i++) {
        for(j = 0; j < 3; j++) {
            printf("%d ", b[i][j]);
        }
        printf("\n");
    }

    return 0;
}
