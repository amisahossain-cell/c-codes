#include <stdio.h>

int searching(int arr[], int n, int key) {
    int i;

    for(i = 0; i < n; i++) {
        if(arr[i] == key) {
            return i;
        }
    }

    return -1;
}

int main() {

    int arr[10] = {10, 20, 30, 40};
    int n = 4;
    int key = 30;

    int result = searching(arr, n, key);

    if(result != -1) {
        printf("Found at index %d\n", result);
    }
    else {
        printf("Not found\n");
    }

    return 0;
}
