#include <stdio.h>

int deletion(int arr[], int n, int pos) {
    int i;

    for(i = pos; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }

    n--;

    return n;
}

int main() {
    int arr[10] = {10, 20, 30, 40, 50};
    int n = 5;
    int pos = 2;
    int i;

    n = deletion(arr, n, pos);

    printf("Element after deletion: ");

    for(i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
